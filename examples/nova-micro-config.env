# Example configuration using Amazon Nova Micro for cost-effective operations
# This configuration uses Nova Micro for context generation, which is:
# - Text-only model optimized for lowest latency and cost
# - Suitable for simple contextual embedding tasks
# - More cost-effective than Claude for basic text processing

# MCP Server Transport Configuration
TRANSPORT=sse
HOST=0.0.0.0
PORT=8051

# OpenAI API Configuration (for embeddings - you can also use Bedrock Titan)
OPENAI_API_KEY=your_openai_api_key

# Supabase Configuration (Required for RAG)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# AWS Configuration (Required for Nova models)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Embeddings Provider - using OpenAI for embeddings (you can also use "bedrock")
EMBEDDINGS_PROVIDER="openai"

# Context Provider - using Bedrock for cost-effective context generation
CONTEXT_PROVIDER="bedrock"

# Nova Micro Model ID - optimized for cost and latency
BEDROCK_CONTEXT_MODEL_ID="amazon.nova-micro-v1:0"

# Alternative Nova models you can use:
# BEDROCK_CONTEXT_MODEL_ID="amazon.nova-lite-v1:0"   # Fast, multimodal
# BEDROCK_CONTEXT_MODEL_ID="amazon.nova-pro-v1:0"    # Advanced, multimodal
# BEDROCK_CONTEXT_MODEL_ID="anthropic.claude-3-5-sonnet-20240620-v1:0"  # High quality Claude
