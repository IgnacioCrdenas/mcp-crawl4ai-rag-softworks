# Nova Lite Configuration Example
# For multimodal content processing with fast response times

# MCP Server Transport Configuration
TRANSPORT=sse
HOST=0.0.0.0
PORT=8051

# OpenAI API Configuration (for embeddings if preferred)
OPENAI_API_KEY=your_openai_api_key

# Supabase Configuration (Required for RAG)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# AWS Configuration (Required for Bedrock models)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Provider Configuration for Nova Lite
EMBEDDINGS_PROVIDER="openai"
CONTEXT_PROVIDER="bedrock"
BEDROCK_CONTEXT_MODEL_ID="amazon.nova-lite-v1:0"

# Nova Lite Characteristics:
# - Multimodal (text, images, video)
# - Fast processing speed
# - Good balance of cost and capability
# - Ideal for documents with visual elements
# - Cost: ~2-3x Nova Micro, but ~66% cheaper than Claude
